# 特特管家推送配置
API_TOKEN=your_tete_guanjia_token_here

# Bark 推送配置（可选）
BARK_SERVER=https://api.day.app
BARK_KEY=
BARK_GROUP=TeslaMate
BARK_SOUND=
BARK_URL=
BARK_ICON=
BARK_LEVEL=

# Teslamate 数据库（docker-compose 中 service 名必须是 database）
DATABASE_HOST=database
DATABASE_USER=teslamate
DATABASE_PASS=your_secure_password
DATABASE_NAME=teslamate
DATABASE_PORT=5432

# MQTT（docker-compose 中 service 名必须是 mosquitto）
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_USER=
MQTT_PASS=

# 其他配置
# 本机联调默认 CAR_ID=1；如需测试其他车辆可显式设置
# CAR_ID=1
LOG_LEVEL=info
PUSH_DEBOUNCE_SECONDS=5

# 本机联调行程详情页 / 轨迹图服务
WEB_HOST=0.0.0.0
WEB_PORT=8080
PUBLIC_BASE_URL=
WEB_URL_SECRET=
TRACK_MAX_POINTS=180

# 地图 provider 配置
# Bark 轨迹图默认使用 OSM，可改为 amap
BARK_MAP_PROVIDER=osm
# 详情页默认 provider，可选 osm / amap
DETAIL_MAP_DEFAULT_PROVIDER=osm
# 详情页顶部允许切换的 provider 列表
DETAIL_MAP_ENABLED_PROVIDERS=osm,amap

# OSM 底图配置（OSM 官方瓦片不需要 API Key，但建议遵守官方使用策略）
OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
OSM_TILE_USER_AGENT=tmbark-notifier/1.0 (+https://github.com/CandyLion/tete-manager-notifier)
OSM_TILE_CACHE_HOURS=168

# 高德地图配置
# Bark 静态图使用 Web服务 Key
AMAP_STATIC_MAP_URL=https://restapi.amap.com/v3/staticmap
AMAP_WEB_SERVICE_KEY=
# 详情页高德交互地图使用 JS Key
AMAP_JS_KEY=
# 2021-12-02 之后新申请的 JS Key 通常需要同时配置安全密钥
AMAP_JS_SECURITY_CODE=
AMAP_JS_VERSION=2.0

# 兼容旧版本（可不填）
# MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# MAP_TILE_USER_AGENT=tmbark-notifier/1.0 (+https://github.com/CandyLion/tete-manager-notifier)
# MAP_TILE_CACHE_HOURS=168
